# ============================================================
# Job Hunter AI - Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# --- Required ---
# MongoDB connection string
DATABASE_URL=mongodb://localhost:27017

# JWT secret for auth tokens (min 32 chars, change in production)
JWT_SECRET=change-me-32-chars-minimum

# AES encryption key for storing API keys (min 32 chars, change in production)
ENCRYPTION_KEY=change-me-32-chars-minimum

# --- AI Providers (at least one required) ---
# Get from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# --- Firecrawl (job scraper) ---
# URL for Firecrawl API instance used by claw-job-search.js
FIRECRAWL_API_URL=http://localhost:3005
